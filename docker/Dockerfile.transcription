################ build container for whisper.cpp / docker_vosk cmdline
FROM nvidia/cuda:13.1.1-cudnn-devel-ubuntu24.04 AS whisper_builder

WORKDIR /opt/build

RUN apt update && apt install -y libhunspell-dev libicu-dev libsndfile1-dev build-essential zlib1g-dev meson libabsl-dev \
    libncurses5-dev libgdbm-dev libnss3-dev libssl-dev libreadline-dev libffi-dev libsqlite3-dev wget libbz2-dev git cmake \
    libboost-all-dev libresample1-dev && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/ZalozbaDev/whisper.cpp.git
RUN cd whisper.cpp && git checkout v1.8.6

ENV CUDA_MAIN_VERSION=13.1
ENV LD_LIBRARY_PATH=/usr/local/cuda-${CUDA_MAIN_VERSION}/compat:$LD_LIBRARY_PATH
RUN cd whisper.cpp/ && cmake -B build -DGGML_CUDA=1 -DCMAKE_CUDA_ARCHITECTURES=89 && cmake --build build -j4 --config Release

RUN touch a

RUN git clone https://github.com/ZalozbaDev/docker_vosk.git
RUN cd docker_vosk && git checkout webcaptioner_v2.2.0_fixes

RUN cd docker_vosk/common/cmdline/ && git clone https://github.com/ZalozbaDev/webrtc-audio-processing.git \
    && cd webrtc-audio-processing && git checkout v2.1 \ 
    && meson . build -Dprefix=$PWD/install && ninja -C build

RUN cd docker_vosk/common/cmdline/ && cp -r ../../../whisper.cpp .

# get ONNX runtime (for Silero)
RUN wget https://github.com/microsoft/onnxruntime/releases/download/v1.12.1/onnxruntime-linux-x64-1.12.1.tgz
RUN mv onnxruntime-linux-x64-1.12.1.tgz docker_vosk/common/cmdline/ && cd docker_vosk/common/cmdline/ && tar xvfz onnxruntime-linux-x64-1.12.1.tgz

RUN cd docker_vosk/common/cmdline/ && ./build_recikts.sh
RUN cd docker_vosk/common/cmdline/ && ./build_whisper_nvidia.sh

################ build container for python apps
FROM nvidia/cuda:13.1.1-cudnn-devel-ubuntu24.04 AS python_builder

WORKDIR /opt/venv/

RUN apt update && apt install -y python3-venv python3-dev && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv/ctranslate2
COPY docker/requirements_ctranslate2.txt /opt/

RUN cd /opt/venv/ctranslate2 && /bin/bash -c 'source bin/activate && pip install -r /opt/requirements_ctranslate2.txt'

RUN python3 -m venv /opt/venv/forcealign
COPY docker/requirements_forcealign.txt /opt/

RUN cd /opt/venv/forcealign && /bin/bash -c 'source bin/activate && pip3 install -r /opt/requirements_forcealign.txt'

COPY src/scripts/align_wav2vec2.py          /opt/venv/forcealign/
COPY src/scripts/translate_srt_sotra_lsf.py /opt/venv/forcealign/

################ build container for node
FROM node:24 AS node_builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
ADD src/ ./src/
RUN npm run build
# RUN ls -l

################ runtime container
FROM nvidia/cuda:13.1.1-runtime-ubuntu24.04

LABEL com.nvidia.cuda.version="12.6"
LABEL license="Includes NVIDIA CUDA redistributables subject to NVIDIA EULA"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt update && apt install -y python3 ffmpeg sox nodejs npm && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/app/src

# whisper.cpp / cmdline übernehmen
COPY --from=whisper_builder /opt/build/whisper.cpp                            /opt/whisper.cpp
COPY --from=whisper_builder /opt/build/docker_vosk/common/cmdline/whisper_out /opt/whisper_out
COPY --from=whisper_builder /opt/build/docker_vosk/common/cmdline/recikts_out /opt/recikts_out

# python apps übernehmen
COPY --from=python_builder /opt/venv /opt/venv

# node backend
COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=node_builder /app/dist ./dist

RUN mkdir -p uploads proprietary whisper

RUN mkdir -p src/scripts
COPY src/scripts/create_transcript.sh  src/scripts/transcript_whisper.sh \ 
     src/scripts/create_forcealign.sh src/scripts/forcealign.sh src/scripts/align_wav2vec2.py \
     src/scripts/log2srt.py src/scripts/log2txt.py \
     src/scripts/translate_srt.sh src/scripts/translate_srt_sotra_lsf.py \
src/scripts

ENV NODE_ENV=production
ENV SERVER_MODE=TRANSCRIPT

CMD ["node", "dist/index.js"]
